           },
           "required": ["model", "before_tokens", "after_tokens", "window_tokens", "threshold_tokens", "compact_usd"],
           "additionalProperties": false
          }, {"type": "null"}], "description": "压缩那天的起点；起点不在这一天时为 null"},
