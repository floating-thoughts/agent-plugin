#!/bin/sh
# Starts agent_core.py with the first Python 3.8 or newer found: $AGENT_CORE_PYTHON, python, python3, then py -3.
# `agent-core --install-cryptography` installs the one package the core needs into that same Python.
core="$(dirname "$0")/agent_core.py"
check='import sys; sys.exit(sys.version_info < (3, 8))'
for py in "${AGENT_CORE_PYTHON:-}" python python3 "py -3"; do
  [ -n "$py" ] || continue
  # shellcheck disable=SC2086  # "py -3" is a command and its argument
  if $py -c "$check" >/dev/null 2>&1; then
    if [ "$1" = "--install-cryptography" ]; then
      exec $py -m pip install --user cryptography
    fi
    exec $py "$core" "$@"
  fi
done
echo "agent-services: no Python 3.8 or newer found (tried python, python3, py -3); install Python 3 and restart" >&2
exit 127
